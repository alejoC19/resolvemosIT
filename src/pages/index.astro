---
import '../styles/global.css';
import site from '../data/site.json';
const wa = site.whatsapp ? `https://wa.me/${site.whatsapp}?text=${encodeURIComponent('Hola, vi Resolvemos IT y quiero consultar por un sistema.')}` : '';
const mail = `mailto:${site.email}?subject=${encodeURIComponent('Consulta desde Resolvemos IT')}`;
const ld = { '@context': 'https://schema.org', '@type': 'Organization', name: site.brand, founder: site.name, description: site.description, email: site.email, address: { '@type': 'PostalAddress', addressLocality: 'Buenos Aires', addressCountry: 'AR' }, sameAs: [site.linkedin] };
---
<!doctype html>
<html lang="es-AR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{site.title}</title>
  <meta name="description" content={site.description} />
  <meta name="theme-color" content="#ffffff" />
  <meta property="og:title" content={site.title} />
  <meta property="og:description" content={site.description} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content="/media/clubos-agendar.jpg" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%23ffffff'/%3E%3Cpath d='M8 23 16 8l8 15' stroke='%235b50e6' stroke-width='3' fill='none'/%3E%3C/svg%3E" />
  <link rel="preload" as="image" href="/media/clubos-agendar.jpg" fetchpriority="high" />
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <script is:inline>document.documentElement.classList.add('js')</script>
</head>
<body>
  <header class="nav"><div class="wrap in">
    <a class="logo" href="#top">{site.brand}</a>
    <nav aria-label="Principal"><ul>
      <li><a href="#que">Qué hago</a></li><li><a href="#trabajos">Trabajos</a></li><li><a href="#cartas">Cartas</a></li><li><a href="#contacto">Contacto</a></li>
    </ul></nav>
  </div></header>

  <main id="top">
    <section class="hero">
      <div class="hero-bg" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
      <div class="wrap hero-top">
        <p class="mono rv">{site.role} · {site.city}</p>
        <h1 class="display h-xl rv" style="margin:1.2rem 0 0">Software que reemplaza <span class="grad">la planilla.</span></h1>
        <div class="hero-meta rv">
          <p class="lead" style="margin:0">Sistemas de gestión, automatizaciones administrativas y cartas digitales para negocios argentinos. Vengo del área contable, y se nota en cómo están armados.</p>
          <div class="stats">{site.stats.map((s) => <div><b>{s.n}</b><span>{s.l}</span></div>)}</div>
        </div>
      </div>
      <div class="hero-stage" data-hero>
        <div class="hero-vid" data-hero-vid>
          <video src="/media/clubos-agendar.mp4" poster="/media/clubos-agendar.jpg" muted loop playsinline preload="metadata" aria-label="Agenda de canchas de PadelApp2 en funcionamiento"></video>
        </div>
        <div class="wrap hero-cap"><span class="mono">PadelApp2 · agendando un turno, en vivo</span><span class="mono">Datos de ejemplo</span></div>
      </div>
    </section>

    <section class="sec" id="que"><div class="wrap">
      <div class="sec-head"><h2 class="display h-lg rv" style="margin:0">Tres cosas que hago bien.</h2><p class="mono rv">01 — Qué hago</p></div>
      {site.services.map((s, i) => (
        <article class="svc rv"><span class="mono">0{i + 1}</span><h3>{s.t}</h3><div><p>{s.d}</p><span class="k">{s.k}</span></div></article>
      ))}
    </div></section>

    <section id="trabajos" aria-label="Trabajos">
      <div class="wrap" style="padding-top:clamp(2rem,5vw,4rem);padding-bottom:2rem"><p class="mono">02 — Trabajos</p></div>
      {site.projects.map((p) => (
        <article class="proj" id={p.id} data-tone={p.tone}>
          <div class="wrap proj-in">
            <div>
              <p class="mono">{p.n} · {p.kind}</p>
              <h3 class="display h-lg">{p.title}</h3>
              <p class="lede">{p.lead}</p>
              <p class="t">{p.text}</p>
              <ul class="pts">{p.points.map((x) => <li>{x}</li>)}</ul>
              <button class="more-btn" type="button" data-open={p.id}>Ver el trabajo <span aria-hidden="true">→</span></button>
            </div>
            <div class="pv" data-pv={p.visual ?? 'video'}>
              {p.video && (
                <div>
                  <div class="win clk" data-open={p.id} role="button" tabindex="0" aria-label={`Abrir ${p.title}`}><div class="win-bar"><i></i><i></i><i></i><span class="mono">{p.title}</span></div>
                    <video src={`/media/${p.video}.mp4`} poster={`/media/${p.video}.jpg`} muted loop playsinline preload="none" data-lazyvid aria-label={`${p.title} en funcionamiento`}></video></div>
                  <p class="cap mono"><span>{p.capL ?? 'Grabación real'}</span><span>{p.note}</span></p>
                </div>
              )}
              {p.visual === 'modules' && (
                <div><div class="win clk" data-open={p.id} role="button" tabindex="0" aria-label={`Abrir ${p.title}`}><div class="win-bar"><i></i><i></i><i></i><span class="mono">Sistema de gestión</span></div>
                  <div class="sch"><div class="mod-grid">
                    <div class="mod-list"><div>Cobros con tarjeta</div><div>Transferencias recibidas</div><div>Cuentas corrientes</div><div>Conciliación</div><div>Tesorería</div><div>Reportes</div></div>
                    <div class="mod-panel"><div class="bar" style="--w:92%"></div><div class="bar" style="--w:61%"></div><div class="bar" style="--w:78%"></div><div class="bar" style="--w:44%"></div><div class="bar" style="--w:85%"></div><div class="bar" style="--w:33%"></div><div class="bar" style="--w:70%"></div></div>
                  </div></div></div>
                  <p class="cap mono"><span>Esquema de módulos</span><span>El sistema real es de uso interno</span></p></div>
              )}
              {p.visual === 'convert' && (
                <div><div class="win clk" data-open={p.id} role="button" tabindex="0" aria-label={`Abrir ${p.title}`}><div class="win-bar"><i></i><i></i><i></i><span class="mono">Conversor</span></div>
                  <div class="sch"><div class="docs">
                    <div class="doc"><h4>extracto.pdf</h4><div class="row ghost"><span>03/11 TRANSF REC</span><span>184.500,00</span></div><div class="row ghost"><span>03/11 COMISION</span><span>-1.240,00</span></div><div class="row ghost"><span>04/11 DEP EFVO</span><span>96.000,00</span></div><div class="row ghost"><span>04/11 IMP DB/CR</span><span>-612,30</span></div></div>
                    <div class="arr" aria-hidden="true">→</div>
                    <div class="doc"><h4>unificado.xlsx</h4><div class="row hit"><span>2025-11-03 · Banco A</span><span>184500.00</span></div><div class="row hit"><span>2025-11-03 · Banco A</span><span>-1240.00</span></div><div class="row hit"><span>2025-11-04 · Banco B</span><span>96000.00</span></div><div class="row hit"><span>2025-11-04 · Banco B</span><span>-612.30</span></div></div>
                  </div></div></div>
                  <p class="cap mono"><span>Ejemplo ilustrativo</span><span>Datos inventados</span></p></div>
              )}
              {p.visual === 'match' && (
                <div><div class="win clk" data-open={p.id} role="button" tabindex="0" aria-label={`Abrir ${p.title}`}><div class="win-bar"><i></i><i></i><i></i><span class="mono">Conciliación</span></div>
                  <div class="sch"><div class="pair" data-pair>
                    <svg aria-hidden="true"><path data-l /><path data-l /><path data-l /></svg>
                    <div class="doc"><h4>Banco</h4><div class="row" data-a><span>03/11</span><span>$ 184.500</span></div><div class="row" data-a><span>04/11</span><span>$ 96.000</span></div><div class="row" data-a><span>05/11</span><span>$ 51.300</span></div></div>
                    <div class="doc"><h4>Comprobantes</h4><div class="row" data-b><span>FC 0001-0412</span><span>$ 184.500</span></div><div class="row" data-b><span>FC 0001-0415</span><span>$ 96.000</span></div><div class="row" data-b><span>FC 0001-0419</span><span>$ 51.300</span></div></div>
                  </div></div></div>
                  <p class="cap mono"><span>Ejemplo ilustrativo</span><span>Datos inventados</span></p></div>
              )}
            </div>
          </div>
        </article>
      ))}
    </section>

    <section class="cartas" id="cartas" data-cartas>
      <div class="cartas-pin" data-cartas-pin>
        <div class="wrap cartas-head">
          <h2 class="display h-lg" style="margin:0">Cartas digitales<br />con QR.</h2>
          <div><p class="lead" style="margin:0 0 .8rem">Fotos de cada plato, buscador, filtros, inglés y precios que se cambian desde el celular.</p><p class="mono">05 — Cuatro estilos, cuatro identidades</p></div>
        </div>
        <div class="track" data-track>
          {site.cartas.map((c) => (
            <figure class="phone"><button class="fr" type="button" data-open={c.id} aria-label={`Abrir carta: ${c.name}`}><video src={`/media/${c.video}.mp4`} poster={`/media/${c.video}.jpg`} muted loop playsinline preload="none" data-lazyvid aria-label={`Carta digital: ${c.name}`}></video></button><figcaption class="mono">{c.name}</figcaption></figure>
          ))}
        </div>
      </div>
    </section>

    <section class="sec"><div class="wrap">
      <div class="sec-head"><h2 class="display h-lg rv" style="margin:0">Y más.</h2><p class="mono rv">06 — Otros proyectos</p></div>
      <div class="more">{site.more.map((m) => <button type="button" class="card rv" data-open={m.id}><span class="mono">{m.k}</span><h4>{m.t} <em aria-hidden="true">→</em></h4><p>{m.d}</p></button>)}</div>
    </div></section>

    <section class="sec" style="padding-top:0"><div class="wrap">
      <div class="sec-head"><h2 class="display h-lg rv" style="margin:0">Cómo trabajo.</h2><p class="mono rv">07 — Proceso</p></div>
      <div class="proc" data-proc><div class="proc-line"><i data-proc-fill></i></div>
        {site.process.map((s) => <div class="step rv"><h4>{s.t}</h4><p>{s.d}</p></div>)}
      </div>
    </div></section>

    <section class="contact" id="contacto"><div class="wrap">
      <p class="mono rv">08 — Contacto</p>
      <h2 class="display h-xl rv" style="margin:1rem 0 2rem">¿Qué se hace a mano en tu negocio?</h2>
      <a class="mail rv" href={mail}>{site.email}</a>
      <div class="btns rv">
        {wa && <a class="btn p" href={wa} target="_blank" rel="noopener">Escribir por WhatsApp</a>}
        <a class={wa ? 'btn' : 'btn p'} href={mail}>Enviar un correo</a>
      </div>
      <dl class="cdata rv">
        <div><dt class="mono">Celular y WhatsApp</dt><dd><a href={`tel:+${site.phone}`}>{site.phoneDisplay}</a></dd></div>
        <div><dt class="mono">Correo</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a></dd></div>
        <div><dt class="mono">LinkedIn</dt><dd><a href={site.linkedin} target="_blank" rel="noopener">linkedin.com/in/alejocardozo</a></dd></div>
        <div><dt class="mono">Ubicación</dt><dd>{site.city}</dd></div>
      </dl>
      <footer class="foot">
        <div><strong>{site.brand}</strong><p class="mono" style="margin:.5rem 0 0">{site.role} · {site.name}</p></div>
        <nav aria-label="Pie"><a href="#que">Qué hago</a><a href="#trabajos">Trabajos</a><a href="#cartas">Cartas</a><a href="#contacto">Contacto</a></nav>
        <div class="fc"><a href={`tel:+${site.phone}`}>{site.phoneDisplay}</a><a href={`mailto:${site.email}`}>{site.email}</a><a href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a><a href={site.github} target="_blank" rel="noopener">GitHub · alejoC19</a></div>
        <p class="mono copy">© 2026 {site.brand} · {site.name} · {site.city} · Los datos de las demos son de ejemplo</p>
      </footer>
    </div></section>
  </main>

  <dialog class="det" id="det" aria-labelledby="det-title">
    <button class="det-x" type="button" data-close aria-label="Cerrar">✕</button>
    <div class="det-in"><div class="det-media" id="det-media"></div><div class="det-body" id="det-body"></div></div>
  </dialog>
  <script type="application/json" id="items" set:html={JSON.stringify({ mail: site.email, items: [
    ...site.projects.map((p) => ({ id: p.id, kind: p.kind, title: p.title, lead: p.lead, text: p.text, points: p.points, stack: '', video: p.video ?? null, url: p.url ?? null })),
    ...site.cartas.map((c) => ({ id: c.id, kind: 'Carta digital con QR', title: c.name, lead: 'Carta para el celular.', text: c.text, points: ['Foto de cada plato', 'Buscador y filtros', 'Versión en inglés', 'Precios que se cambian desde el celular'], stack: '', video: c.video, url: c.url, phone: true })),
    ...site.more.map((m) => ({ id: m.id, kind: m.k, title: m.t, lead: '', text: m.d, points: m.points, stack: '', video: null, url: null })),
  ] })} />
  <script>
    import gsap from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    import Lenis from 'lenis';
    gsap.registerPlugin(ScrollTrigger);

    // Videos: solo se reproducen los que están a la vista
    const vids = [...document.querySelectorAll<HTMLVideoElement>('video')];
    const io = new IntersectionObserver((es) => es.forEach((e) => {
      const v = e.target as HTMLVideoElement;
      if (e.isIntersecting) { v.play().catch(() => {}); } else v.pause();
    }), { rootMargin: '120px' });
    vids.forEach((v) => io.observe(v));

    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let lenis: Lenis | null = null;
    if (!reduce) {
      lenis = new Lenis({ lerp: 0.09, smoothWheel: true });
      lenis.on('scroll', ScrollTrigger.update);
      gsap.ticker.add((t) => lenis!.raf(t * 1000));
      gsap.ticker.lagSmoothing(0);

      // Aparición
      gsap.utils.toArray<HTMLElement>('.rv').forEach((el) => {
        gsap.to(el, { opacity: 1, y: 0, duration: 0.9, ease: 'power3.out', scrollTrigger: { trigger: el, start: 'top 88%', once: true } });
      });

      // Portada: el video crece hasta ocupar toda la pantalla
      const hv = document.querySelector<HTMLElement>('[data-hero-vid]')!;
      gsap.fromTo(hv, { clipPath: 'inset(6% 14% 6% 14% round 18px)' }, { clipPath: 'inset(0% 0% 0% 0% round 0px)', ease: 'none',
        scrollTrigger: { trigger: '[data-hero]', start: 'top 85%', end: 'top 5%', scrub: true } });
      gsap.fromTo('[data-hero-vid] video', { scale: 1.12 }, { scale: 1, ease: 'none', scrollTrigger: { trigger: '[data-hero]', start: 'top 85%', end: 'top 5%', scrub: true } });

      // Línea del proceso
      gsap.to('[data-proc-fill]', { scaleY: 1, ease: 'none', scrollTrigger: { trigger: '[data-proc]', start: 'top 70%', end: 'bottom 70%', scrub: true } });

      // Esquema de conciliación: líneas que unen cada par
      const pair = document.querySelector<HTMLElement>('[data-pair]');
      if (pair) {
        const draw = () => {
          const pr = pair.getBoundingClientRect();
          const A = [...pair.querySelectorAll<HTMLElement>('[data-a]')], B = [...pair.querySelectorAll<HTMLElement>('[data-b]')];
          const paths = [...pair.querySelectorAll<SVGPathElement>('[data-l]')];
          paths.forEach((p, i) => {
            const a = A[i].getBoundingClientRect(), b = B[i].getBoundingClientRect();
            const x1 = a.right - pr.left, y1 = a.top + a.height / 2 - pr.top, x2 = b.left - pr.left, y2 = b.top + b.height / 2 - pr.top, m = (x1 + x2) / 2;
            p.setAttribute('d', `M${x1} ${y1} C${m} ${y1} ${m} ${y2} ${x2} ${y2}`);
            const len = p.getTotalLength(); p.style.strokeDasharray = String(len); p.style.strokeDashoffset = String(len);
          });
          return paths;
        };
        const paths = draw();
        gsap.to(paths, { strokeDashoffset: 0, duration: 0.9, stagger: 0.35, ease: 'power2.inOut', scrollTrigger: { trigger: pair, start: 'top 75%', once: true } });
      }

      // Proyectos apilados: el panel anterior se aleja al llegar el siguiente
      gsap.matchMedia().add('(min-width: 900px)', () => {
        const panels = gsap.utils.toArray<HTMLElement>('.proj');
        panels.slice(0, -1).forEach((p, i) => {
          gsap.to(p.querySelector('.proj-in'), { scale: 0.94, opacity: 0.35, ease: 'none',
            scrollTrigger: { trigger: panels[i + 1], start: 'top bottom', end: 'top top', scrub: true } });
        });

        // Cartas: recorrido horizontal fijado
        const track = document.querySelector<HTMLElement>('[data-track]')!;
        const pin = document.querySelector<HTMLElement>('[data-cartas-pin]')!;
        const dist = () => track.scrollWidth - innerWidth;
        gsap.to(track, { x: () => -dist(), ease: 'none',
          scrollTrigger: { trigger: pin, start: 'top top', end: () => '+=' + dist(), pin: true, scrub: 0.6, invalidateOnRefresh: true } });
      });
    } else {
      document.querySelectorAll<SVGPathElement>('[data-l]').forEach(() => {});
    }
    // Detalle de cada trabajo
    type Item = { id: string; kind: string; title: string; lead: string; text: string; points: string[]; stack: string; video: string | null; url?: string | null; phone?: boolean };
    const raw = JSON.parse(document.getElementById('items')!.textContent!) as { mail: string; items: Item[] };
    const byId = new Map(raw.items.map((i) => [i.id, i]));
    const dlg = document.getElementById('det') as HTMLDialogElement;
    const mediaEl = document.getElementById('det-media')!;
    const bodyEl = document.getElementById('det-body')!;
    const el = (tag: string, cls?: string, text?: string) => { const e = document.createElement(tag); if (cls) e.className = cls; if (text) e.textContent = text; return e; };
    function openItem(id: string) {
      const it = byId.get(id); if (!it) return;
      mediaEl.replaceChildren(); bodyEl.replaceChildren();
      mediaEl.className = 'det-media' + (it.phone ? ' ph' : '');
      if (it.video) {
        const v = document.createElement('video');
        v.src = `/media/${it.video}.mp4`; v.poster = `/media/${it.video}.jpg`;
        v.muted = true; v.loop = true; v.autoplay = true; v.playsInline = true; v.setAttribute('aria-label', it.title);
        mediaEl.append(v); v.play().catch(() => {});
      } else {
        const src = document.querySelector(`#${CSS.escape(id)} .pv .win`);
        if (src) { const c = src.cloneNode(true) as HTMLElement; c.classList.remove('clk'); c.removeAttribute('role'); c.removeAttribute('tabindex'); mediaEl.append(c); }
      }
      bodyEl.append(el('p', 'mono', it.kind));
      const h = el('h3', undefined, it.title); h.id = 'det-title'; bodyEl.append(h);
      if (it.lead) bodyEl.append(el('p', 'lede', it.lead));
      bodyEl.append(el('p', 't', it.text));
      const ul = el('ul', 'pts'); it.points.forEach((x) => ul.append(el('li', undefined, x))); bodyEl.append(ul);
      const btns = el('div', 'btns');
      if (it.url) { const a = el('a', 'btn p', 'Ver en vivo ↗') as HTMLAnchorElement; a.href = it.url; a.target = '_blank'; a.rel = 'noopener'; btns.append(a); }
      const m = el('a', it.url ? 'btn' : 'btn p', 'Quiero algo así') as HTMLAnchorElement;
      m.href = `mailto:${raw.mail}?subject=${encodeURIComponent('Consulta: algo como ' + it.title)}`; btns.append(m);
      bodyEl.append(btns);
      lenis?.stop(); dlg.showModal();
    }
    document.addEventListener('click', (e) => { const t = (e.target as HTMLElement).closest<HTMLElement>('[data-open]'); if (t) openItem(t.dataset.open!); });
    document.addEventListener('keydown', (e) => {
      const t = (e.target as HTMLElement).closest<HTMLElement>('[data-open][role="button"]');
      if (t && (e.key === 'Enter' || e.key === ' ')) { e.preventDefault(); openItem(t.dataset.open!); }
    });
    dlg.addEventListener('click', (e) => { if (e.target === dlg || (e.target as HTMLElement).closest('[data-close]')) dlg.close(); });
    dlg.addEventListener('close', () => { mediaEl.querySelectorAll('video').forEach((v) => v.pause()); mediaEl.replaceChildren(); lenis?.start(); });

    addEventListener('load', () => ScrollTrigger.refresh());
  </script>
</body>
</html>
